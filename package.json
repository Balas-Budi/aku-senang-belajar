{
    "name": "aku-senang-belajar",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "dev": "nx run-many -t dev --projects=backend,frontend --parallel=2",
        "dev:backend": "nx run backend:dev",
        "dev:frontend": "nx run frontend:dev",
        "build": "nx run-many -t build --projects=backend,frontend",
        "build:backend": "nx run backend:build",
        "build:frontend": "nx run frontend:build",
        "typecheck": "nx run-many -t typecheck --projects=backend,frontend",
        "format": "nx run-many -t format --projects=backend,frontend",
        "format:check": "nx run-many -t format-check --projects=backend,frontend",
        "check": "npm run format:check && npm run typecheck && npm run build",
        "start": "nx run backend:start",
        "preview": "nx run frontend:preview",
        "db:generate": "nx run backend:db-generate",
        "db:migrate": "nx run backend:db-migrate",
        "graph": "nx graph"
    },
    "private": true,
    "dependencies": {
        "@tanstack/react-query": "^5.105.0",
        "drizzle-orm": "^0.45.4",
        "fastify": "^5.12.7",
        "pg": "^8.23.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1"
    },
    "devDependencies": {
        "@nx/js": "24.0.0",
        "@swc-node/register": "1.11.1",
        "@swc/core": "1.15.8",
        "@swc/helpers": "0.5.18",
        "@types/node": "^24.0.0",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "drizzle-kit": "^0.31.11",
        "nx": "24.0.0",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tslib": "^2.3.0",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "vite": "^8.3.5"
    },
    "workspaces": [
        "packages/*"
    ],
    "packageManager": "npm@11.6.2",
    "type": "module"
}
