{
    "name": "@aku-senang-belajar/backend",
    "private": true,
    "type": "module",
    "nx": {
        "name": "backend",
        "targets": {
            "build": {
                "command": "tsc -p packages/backend/tsconfig.build.json",
                "outputs": [
                    "{workspaceRoot}/dist/backend"
                ],
                "cache": true
            },
            "serve": {
                "command": "node --watch packages/backend/src/main.ts",
                "continuous": true,
                "cache": false
            },
            "dev": {
                "command": "node --watch packages/backend/src/main.ts",
                "continuous": true,
                "cache": false
            },
            "typecheck": {
                "executor": "nx:run-commands",
                "options": {
                    "cwd": "{workspaceRoot}",
                    "command": "tsc -p packages/backend/tsconfig.json"
                },
                "cache": true,
                "inputs": [
                    "default"
                ],
                "outputs": [],
                "syncGenerators": []
            },
            "test": {
                "command": "node --env-file-if-exists=../../.env --test --test-global-setup=tests/setup.ts \"tests/**/*.test.ts\"",
                "options": {
                    "cwd": "packages/backend"
                },
                "cache": false
            },
            "format": {
                "command": "prettier --write packages/backend",
                "cache": false
            },
            "format-check": {
                "command": "prettier --check packages/backend",
                "cache": true,
                "inputs": [
                    "default"
                ],
                "outputs": []
            },
            "start": {
                "command": "node dist/backend/main.js",
                "dependsOn": [
                    "build"
                ],
                "continuous": true,
                "cache": false
            },
            "db-generate": {
                "command": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
                "cache": false
            },
            "db-migrate": {
                "command": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
                "cache": false
            },
            "create-admin": {
                "command": "node --env-file-if-exists=.env packages/backend/src/scripts/create-admin.ts",
                "cache": false
            },
            "seed-sample-sessions": {
                "command": "node --env-file-if-exists=.env packages/backend/src/scripts/seed-sample-sessions.ts",
                "cache": false
            }
        }
    }
}
