{
    "name": "@aku-senang-belajar/frontend",
    "private": true,
    "type": "module",
    "nx": {
        "name": "frontend",
        "targets": {
            "build": {
                "command": "react-router build",
                "options": {
                    "cwd": "packages/frontend"
                },
                "outputs": [
                    "{workspaceRoot}/dist/frontend"
                ],
                "cache": true
            },
            "serve": {
                "command": "react-router dev",
                "options": {
                    "cwd": "packages/frontend"
                },
                "continuous": true,
                "cache": false
            },
            "dev": {
                "command": "react-router dev",
                "options": {
                    "cwd": "packages/frontend"
                },
                "continuous": true,
                "cache": false
            },
            "typecheck": {
                "command": "react-router typegen && tsc --noEmit",
                "options": {
                    "cwd": "packages/frontend"
                },
                "cache": true,
                "inputs": [
                    "default"
                ],
                "outputs": []
            },
            "format": {
                "command": "prettier --write packages/frontend",
                "cache": false
            },
            "format-check": {
                "command": "prettier --check packages/frontend",
                "cache": true,
                "inputs": [
                    "default"
                ],
                "outputs": []
            },
            "preview": {
                "command": "HOST=127.0.0.1 PORT=4300 react-router-serve ../../dist/frontend/server/index.js",
                "options": {
                    "cwd": "packages/frontend"
                },
                "dependsOn": [
                    "build"
                ],
                "continuous": true,
                "cache": false
            }
        }
    },
    "dependencies": {
        "isbot": "^5.2.2"
    }
}
